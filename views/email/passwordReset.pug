extends _baseEmail

block content
  p Hi #{firstName},
    p Welcome to Natours, we're glad to have you 🎉🙏
    p Forgot yout password? Submit a PATCH request with yout new password and password confirm to #{url}.
    p (Website for this action not yet implemented.)
    table.btn.btn-primary(role='presentation', border='0', cellpadding='0', cellspacing='0')
      tbody
        tr
          td(align='left')
            table(role='presentation', border='0', cellpadding='0', cellspacing='0')
              tbody
                tr
                  td
                    a(href=`${url}`, target='_blank') Reset yout password
    p If you didn't forget yout password, please ignore this email!
